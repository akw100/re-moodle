{
  "manifest_version": 3,
  "name": "Re-Moodle",
  "version": "0.1.0",
  "description": "Remodel your Moodle: themes, a done list, to-dos, shortcuts, confetti and a tiny game.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Re-Moodle"
  },
  "content_scripts": [
    {
      "matches": [
        "https://moodle.huji.ac.il/*"
      ],
      "run_at": "document_start",
      "js": [
        "src/early.js"
      ],
      "css": [
        "src/base.css",
        "themes/quiet-focus.css",
        "themes/night-operator.css",
        "themes/daily-quest.css",
        "themes/campus-pop.css",
        "themes/ahead.css",
        "themes/fal.css",
        "themes/giga.css",
        "themes/cloudstudio.css",
        "themes/butter.css",
        "themes/clay.css"
      ]
    },
    {
      "matches": [
        "https://idp.cc.huji.ac.il/simplesaml/*"
      ],
      "run_at": "document_start",
      "js": [
        "src/early.js"
      ],
      "css": [
        "src/base.css",
        "themes/quiet-focus.css",
        "themes/night-operator.css",
        "themes/daily-quest.css",
        "themes/campus-pop.css",
        "themes/ahead.css",
        "themes/fal.css",
        "themes/giga.css",
        "themes/cloudstudio.css",
        "themes/butter.css",
        "themes/clay.css",
        "src/login.css"
      ]
    },
    {
      "matches": [
        "https://moodle.huji.ac.il/*"
      ],
      "run_at": "document_end",
      "world": "MAIN",
      "js": [
        "src/bridge.js"
      ]
    },
    {
      "matches": [
        "https://moodle.huji.ac.il/*"
      ],
      "run_at": "document_idle",
      "js": [
        "src/core.js",
        "src/classify.js",
        "src/features/confetti.js",
        "src/features/upcoming.js",
        "src/features/todo.js",
        "src/features/shortcuts.js",
        "src/features/game.js",
        "src/main.js"
      ],
      "css": [
        "src/features/upcoming.css",
        "src/features/todo.css",
        "src/features/shortcuts.css",
        "src/features/game.css"
      ]
    }
  ]
}
