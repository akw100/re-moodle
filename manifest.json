{
  "manifest_version": 3,
  "name": "Re-Moodle",
  "version": "1.0.1",
  "description": "Remodel your Moodle: themes, a done list, to-dos, shortcuts, confetti and a tiny game.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Re-Moodle",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://moodle.huji.ac.il/*"
      ],
      "run_at": "document_start",
      "js": [
        "src/early.js"
      ],
      "css": [
        "src/base.css",
        "themes/quiet-focus.css",
        "themes/night-operator.css",
        "themes/daily-quest.css",
        "themes/campus-pop.css",
        "themes/ahead.css",
        "themes/fal.css",
        "themes/giga.css",
        "themes/cloudstudio.css",
        "themes/butter.css",
        "themes/clay.css"
      ]
    },
    {
      "matches": [
        "https://idp.cc.huji.ac.il/simplesaml/*"
      ],
      "run_at": "document_start",
      "js": [
        "src/early.js"
      ],
      "css": [
        "src/base.css",
        "themes/quiet-focus.css",
        "themes/night-operator.css",
        "themes/daily-quest.css",
        "themes/campus-pop.css",
        "themes/ahead.css",
        "themes/fal.css",
        "themes/giga.css",
        "themes/cloudstudio.css",
        "themes/butter.css",
        "themes/clay.css",
        "src/login.css"
      ]
    },
    {
      "matches": [
        "https://moodle.huji.ac.il/*"
      ],
      "run_at": "document_end",
      "world": "MAIN",
      "js": [
        "src/bridge.js"
      ]
    },
    {
      "matches": [
        "https://moodle.huji.ac.il/*"
      ],
      "run_at": "document_idle",
      "js": [
        "src/core.js",
        "src/classify.js",
        "src/features/confetti.js",
        "src/features/upcoming.js",
        "src/features/todo.js",
        "src/features/shortcuts.js",
        "src/features/game.js",
        "src/features/backgrounds.js",
        "src/features/motd.js",
        "src/features/categories.js",
        "src/main.js"
      ],
      "css": [
        "src/features/upcoming.css",
        "src/features/todo.css",
        "src/features/shortcuts.css",
        "src/features/game.css",
        "src/features/backgrounds.css",
        "src/features/motd.css"
      ]
    }
  ]
}
